# EduConnect Environment Configuration

# Database Connection (PostgreSQL for Vercel / Cloud Hosting; or local PostgreSQL)
DATABASE_URL="postgres://user:password@host:5432/dbname?sslmode=require"

# Session & JWT Secrets
AUTH_SECRET="educonnect_super_secret_session_key_2026_change_in_production"
NEXTAUTH_URL="http://localhost:3000"

# Email Provider Configuration
# Supported values: "resend" (Resend API) | "smtp" | "console"
EMAIL_PROVIDER="resend"
EMAIL_FROM="EduConnect <onboarding@resend.dev>"

# Resend Transactional Email Provider Configuration
RESEND_API_KEY="re_your_resend_api_key_here"
RESEND_FROM_EMAIL="onboarding@resend.dev"
RESEND_FROM_NAME="EduConnect"

# SMTP Configuration (Optional fallback, e.g. Gmail SSL Port 465)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE="true"
SMTP_USER="educonnectbyprofunnel@gmail.com"
SMTP_PASSWORD="your_app_password_here"

# Application Base URL
APP_URL="http://localhost:3000"

# OTP Security & Rate Limiting Settings
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
ADMIN_UNIVERSAL_OTP="123456"

# Environment Mode
NODE_ENV="development"

# Centralized Currency Configuration
NEXT_PUBLIC_CURRENCY="INR"
NEXT_PUBLIC_CURRENCY_SYMBOL="₹"

