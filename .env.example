# EduConnects Environment Configuration

# Database Connection (PostgreSQL for Vercel / Cloud Hosting; or local PostgreSQL)
DATABASE_URL="postgres://user:password@host:5432/dbname?sslmode=require"

# Session & JWT Secrets
AUTH_SECRET="educonnects_super_secret_session_key_2026_change_in_production"
NEXTAUTH_URL="http://localhost:3000"

# Email Provider Configuration
# Supported values: "resend" (Resend API) | "smtp" | "console"
EMAIL_PROVIDER="resend"
EMAIL_FROM="EduConnects <onboarding@resend.dev>"

# Resend Transactional Email Provider Configuration
RESEND_API_KEY="re_your_resend_api_key_here"
RESEND_FROM_EMAIL="onboarding@resend.dev"
RESEND_FROM_NAME="EduConnects"

# SMTP Configuration (Optional fallback, e.g. Gmail SSL Port 465)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE="true"
SMTP_USER="educonnectbyprofunnel@gmail.com"
SMTP_PASSWORD="your_app_password_here"

# Application Base & Subdomain URLs (Set to public production domains in production)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_MAIN_DOMAIN="https://educonnects.co.in"
NEXT_PUBLIC_STUDENT_DOMAIN="https://learners.educonnects.co.in"
NEXT_PUBLIC_EDUCATOR_DOMAIN="https://educators.educonnects.co.in"
NEXT_PUBLIC_LIVE_DOMAIN="https://live.educonnects.co.in"
NEXT_PUBLIC_LIVE_URL="https://live.educonnects.co.in"

# OTP Security & Rate Limiting Settings
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
ADMIN_UNIVERSAL_OTP="123456"

# Environment Mode
NODE_ENV="development"

# Centralized Currency Configuration
NEXT_PUBLIC_CURRENCY="INR"
NEXT_PUBLIC_CURRENCY_SYMBOL="₹"

# Cashfree Payments Gateway Configuration (API Version 2023-08-01)
CASHFREE_APP_ID="your_cashfree_app_id_here"
CASHFREE_SECRET_KEY="your_cashfree_secret_key_here"
CASHFREE_ENV="SANDBOX"
CASHFREE_API_VERSION="2023-08-01"
CASHFREE_SPLIT_ENABLED="true"
