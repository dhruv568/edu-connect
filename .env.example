# EduConnect Environment Configuration

# Database Connection (PostgreSQL for Vercel / Cloud Hosting; or local PostgreSQL)
DATABASE_URL="postgres://user:password@host:5432/dbname?sslmode=require"

# Session & JWT Secrets
AUTH_SECRET="educonnect_super_secret_session_key_2026_change_in_production"
NEXTAUTH_URL="http://localhost:3000"

# Email Provider Configuration
# Supported values: "smtp" (Production SMTP/Gmail SSL) | "console" | "resend"
EMAIL_PROVIDER="smtp"
EMAIL_FROM="EduConnect Verification <educonnectbyprofunnel@gmail.com>"

# SMTP Configuration (e.g. Gmail SSL Port 465 or Port 587)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE="true"
SMTP_USER="educonnectbyprofunnel@gmail.com"
SMTP_PASSWORD="your_app_password_here"

# Resend Transactional Email Provider Configuration (Optional alternative)
RESEND_API_KEY="YOUR_RESEND_API_KEY"
RESEND_FROM_EMAIL="no-reply@yourdomain.com"
RESEND_FROM_NAME="EduConnect"

# Application Base URL
APP_URL="http://localhost:3000"

# OTP Security & Rate Limiting Settings
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Environment Mode
NODE_ENV="development"

