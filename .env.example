# EduConnect Environment Configuration

# Database Connection (SQLite default for zero-config dev; compatible with PostgreSQL)
DATABASE_URL="file:./dev.db"

# Session & JWT Secrets
AUTH_SECRET="educonnect_super_secret_session_key_2026_change_in_production"
NEXTAUTH_URL="http://localhost:3000"

# Email Provider Configuration
# Supported values: "console" (default dev logger) | "smtp" (Nodemailer)
EMAIL_PROVIDER="console"
EMAIL_FROM="EduConnect Verification <no-reply@educonnect.com>"

# Optional SMTP Settings (required only when EMAIL_PROVIDER="smtp")
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="smtp_user_placeholder"
SMTP_PASSWORD="smtp_password_placeholder"

# Environment Mode
NODE_ENV="development"
