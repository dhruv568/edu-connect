# EduConnect Environment Configuration

# Database Connection (PostgreSQL for Vercel / Cloud Hosting; or local PostgreSQL)
DATABASE_URL="postgres://user:password@host:5432/dbname?sslmode=require"

# Session & JWT Secrets
AUTH_SECRET="educonnect_super_secret_session_key_2026_change_in_production"
NEXTAUTH_URL="http://localhost:3000"

# Email Provider Configuration
# Supported values: "resend" (Production Resend API) | "console" (Dev Logger) | "smtp" (Nodemailer)
EMAIL_PROVIDER="console"
EMAIL_FROM="EduConnect Verification <no-reply@educonnect.com>"

# Resend Transactional Email Provider Configuration
RESEND_API_KEY="YOUR_NEW_RESEND_API_KEY"
RESEND_DOMAIN_ID="92ef15aa-be5c-4a44-8a7e-a5982ec50dcb"
RESEND_FROM_EMAIL="no-reply@yourdomain.com"
RESEND_FROM_NAME="EduConnect"

# Application Base URL
APP_URL="http://localhost:3000"

# OTP Security & Rate Limiting Settings
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Optional SMTP Settings (required only when EMAIL_PROVIDER="smtp")
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="smtp_user_placeholder"
SMTP_PASSWORD="smtp_password_placeholder"

# Environment Mode
NODE_ENV="development"

